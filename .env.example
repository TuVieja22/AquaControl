# Plantilla de configuracion de AquaControl.
# Copiala como ".env" y completa los valores vacios. El .env real NO se sube a GitHub.

#--------------------------------------------------------------------
# ENTORNO
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

# Barra de depuracion de CodeIgniter. Hace las paginas mucho mas pesadas: activala
# (sacandole el # a la linea) solo mientras buscas un error.
# toolbar.activo = true

#--------------------------------------------------------------------
# BASE DE DATOS (XAMPP por defecto: usuario root sin contrasena)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = aquacare
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# EMAIL (Gmail: usar una contrasena de aplicacion SIN espacios,
# https://myaccount.google.com/apppasswords)
#--------------------------------------------------------------------

email.fromEmail =
email.fromName = AquaControl
email.SMTPHost = smtp.gmail.com
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# TIENDA
#--------------------------------------------------------------------

commerce.unitPrice = 50000
commerce.productSku = aquacontrol
commerce.productName = AquaControl
commerce.productDescription = 'Elegí la cantidad, revisá tu pedido y continuá con el medio de pago que prefieras sin salir de la experiencia AquaControl.'
commerce.currency = ARS
commerce.maxQuantity = 6
commerce.deliveryMessage = 'La entrega y activación se coordinan al confirmar el pago.'
commerce.locale = es-AR

#--------------------------------------------------------------------
# CUENTAS DE PRUEBA
# Dias que puede usar el panel una cuenta sin AquaControl antes de borrarse.
#--------------------------------------------------------------------

cuentas.diasDePrueba = 7

#--------------------------------------------------------------------
# NOTIFICACIONES PUSH (alertas de la pecera en el celular)
# Se crean con: php spark notificaciones:claves (la privada no se comparte).
#--------------------------------------------------------------------

webpush.clavePublica =
webpush.clavePrivada =

#--------------------------------------------------------------------
# MERCADO PAGO (credenciales en mercadopago.com.ar/developers > Tus integraciones)
# runtime = local solo en desarrollo. notificationUrl debe ser una URL publica (webhook).
#--------------------------------------------------------------------

mercadopago.runtime = local
mercadopago.accessToken =
mercadopago.publicKey =
mercadopago.installments = 12
mercadopago.notificationUrl =
mercadopago.webhookSecret =
mercadopago.autoReturn = 
mercadopago.statementDescriptor = 
